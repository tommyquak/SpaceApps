# peat swamp for temporal baselines beyond ~3 months (Offoutliers culls to zero
# and crashes); ALOS-2 precise orbits make geometric offsets sub-pixel [S].
--- isce/components/isceobj/Alos2Proc/runSlcOffset.py.orig
+++ isce/components/isceobj/Alos2Proc/runSlcOffset.py
@@ -83 +83 @@
-                if (landRatio <= 0.00125):
+                if (landRatio <= 0.00125) or (os.environ.get("ALOS2_FORCE_GEOM_OFFSET", "") == "1"):
